[Unit]
Description=PS2MUD Pike world server
After=network.target

[Service]
Type=simple
User=chatgpt
Group=chatgpt
WorkingDirectory=/home/chatgpt/ps2mud/.runtime/pike
ExecStart=/bin/sh /home/chatgpt/ps2mud/deploy/vps/run-pike.sh
Restart=on-failure
RestartSec=3
TimeoutStopSec=90
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/chatgpt/ps2mud/.runtime/pike

[Install]
WantedBy=multi-user.target
